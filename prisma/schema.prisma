datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String   // Securely hashed password (bcrypt)
  avatar         String?  @db.Text
  role           String   // ADMIN, LAHORE_USER, MULTAN_USER
  assignedEntity String?  // Lahore, Multan
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Budget {
  id        String   @id @default(cuid())
  entity    String   // Lahore, Multan
  month     String   // e.g. "August"
  year      Int      // e.g. 2026
  amount    Float    // Allocated budget limit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, month, year])
}

model GroceryEntry {
  id              String   @id @default(cuid())
  entity          String   // Lahore, Multan
  date            String   // YYYY-MM-DD format
  details         String   @db.Text
  amount          Float
  addedBy         String
  status          String   // "Slip Uploaded", "Slip Missing", "Approved Without Slip"
  slipUrl         String?  @db.LongText
  slipType        String?  // "image", "pdf"
  approvedByAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
