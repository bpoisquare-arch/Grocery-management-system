datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String   // Securely hashed password (bcrypt)
  avatar         String?  @db.Text
  role           String   // ADMIN, LAHORE_USER, MULTAN_USER, ISQUAREBPO_USER
  assignedEntity String?  // Lahore, Multan, ISquareBPO
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Budget {
  id        String   @id @default(cuid())
  entity    String   // Lahore, Multan, ISquareBPO
  month     String   // e.g. "August"
  year      Int      // e.g. 2026
  amount    Float    // Allocated budget limit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, month, year])
}

model GroceryEntry {
  id              String   @id @default(cuid())
  entity          String   // Lahore, Multan, ISquareBPO
  date            String   // YYYY-MM-DD format
  details         String   @db.Text
  amount          Float
  addedBy         String
  status          String   // "Slip Uploaded", "Slip Missing", "Approved Without Slip"
  budgetMonth     String?  // Assigned Budget Month e.g. "August"
  budgetYear      Int?     // Assigned Budget Year e.g. 2026
  slipUrl         String?  @db.LongText
  slipUrls        String?  @db.LongText // JSON string array of up to 10 URLs
  slipType        String?  // "image", "pdf"
  approvedByAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Counselor {
  id                   String   @id @default(cuid())
  name                 String
  entity               String   @default("All") // "Lahore", "Multan", "ISquareBPO", "All"
  email                String?
  phone                String?
  serviceCommissions   String?  @db.LongText // JSON string of CounselorServiceCommissions
  bmServiceCommissions String?  @db.LongText // JSON string of CounselorServiceCommissions
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CommissionEntry {
  id                  String   @id @default(cuid())
  entity              String   // Lahore, Multan, ISquareBPO
  studentName         String
  service             String   // Visa Processing, PTE, Visa Granted, IELTS, FBR Document, Proof of Deposit
  counselor           String
  amount              Float
  date                String   // YYYY-MM-DD format
  fullReceived        Boolean  @default(false)
  counselorCommission Float    @default(0)
  bmCommission        Float    @default(0)
  status              String   @default("Slip Missing") // "Slip Uploaded", "Slip Missing", "Approved Without Slip"
  slipUrl             String?  @db.LongText
  slipUrls            String?  @db.LongText // JSON string array of URLs
  slipType            String?  // "image", "pdf"
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

